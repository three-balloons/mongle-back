model Role {
    id          Int       @id @default(autoincrement())
    roleType    RoleType
    userId      Int
    user        User      @relation(fields: [userId], references: [id])
    workspaceId Int
    workspace   Workspace @relation(fields: [workspaceId], references: [id])

    @@unique([userId, workspaceId])
}

enum RoleType {
    VIEWER
    EDITOR
    OWNER
}
