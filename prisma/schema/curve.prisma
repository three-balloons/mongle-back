model Curve {
    id        Int       @id @default(autoincrement())
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
    color     String
    position  String    @db.Text
    thickness Int
    bubbleId  Int
    bubble    Bubble    @relation(fields: [bubbleId], references: [id])
}
